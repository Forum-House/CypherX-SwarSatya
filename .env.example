# ---- Used by Hardhat (deploy.js, authorize-reporter.js) ----
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=your_deployer_wallet_private_key_no_0x_prefix

# Filled in after running: npm run deploy:amoy
CONTRACT_ADDRESS=

# The backend/reporter wallet address you want authorize-reporter.js to approve
BACKEND_REPORTER_ADDRESS=

# ---- Used by python/demo.py ----
USER_PRIVATE_KEY=demo_user_wallet_private_key_no_0x_prefix
BACKEND_PRIVATE_KEY=demo_backend_wallet_private_key_no_0x_prefix
